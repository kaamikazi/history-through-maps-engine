    "width_px": 1.0,
    "alpha": 0.9,
    "steps": [
      [
        11,
        5
      ],
      [
        0,
        1
      ]
    ]
  },
  "hatch_in": 0.8,
  "fills": {
    "territory": {
      "color": "@territory",
      "alpha": 1.0,
      "hatch": {
        "angle": 45,
        "spacing_px": 6,
        "width_px": 1.4,
        "color": "@madder"
      },
      "outline": "@ink",
      "outline_px": 2.4
    },
    "second": {
      "color": "@verdigris",
      "alpha": 0.85,
      "outline": "@ink",
      "outline_px": 2.0
    },
    "contested": {
      "color": "none",
      "alpha": 1.0,
      "hatch": {
        "angle": 45,
        "spacing_px": 6,
        "width_px": 1.4,
        "color": "@madder"
      },
      "outline": "@map-border",
      "outline_px": 2.0,
      "dashed": true
    }
  },
  "line": {
    "ink": "@ink",
    "layers": [
      [
        2.6,
