{
  "name": "Paper (brand)",
  "note": "History Through Maps brand, LIGHT theme, used for THUMBNAILS and stills. Colours are brand tokens ('@ink' etc.) read from brand/tokens.json. Sizes ending in _px are pixels at 1080p; 'widths' are points (1 px = 0.72 pt).",
  "tokens_file": "../brand/tokens.json",
  "theme": "light",
  "brand": true,
  "captions": false,
  "fonts": {
    "display": "IMFeENit28P.ttf",
    "caps": "CormorantSC-SemiBold.ttf",
    "body": "EBGaramond-wght.ttf",
    "body_italic": "EBGaramond-Italic-wght.ttf"
  },
  "colors": {
    "sea": "@map-water",
    "land": "@map-land",
    "border": "@map-border",
    "coast": "@map-border",
    "river": "@verdigris",
    "admin1": "@hairline",
    "waterline": "@hairline",
    "title_dim": "@ground"
  },
  "widths": {
    "border": 1.08,
    "coast": 1.44,
    "river": 0.7,
    "admin1": 0.6
  },
  "river_alpha": 0.55,
  "admin1_alpha": 0.9,
  "land_hatch": {
    "angle": 60,
    "spacing_px": 8,
    "width_px": 0.8,
    "color": "@map-hatch"
  },
  "graticule": {
